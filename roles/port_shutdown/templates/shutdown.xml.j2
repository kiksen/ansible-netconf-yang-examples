{% set port_shutdown_if_type = port_shutdown_interface | kiksen.netconf.interface_part('type') %}
{% set port_shutdown_if_id = port_shutdown_interface | kiksen.netconf.interface_part('id') %}
<config xmlns="urn:ietf:params:xml:ns:netconf:base:1.0">
  <native xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-native">
    <interface>
      <{{ port_shutdown_if_type }}>
        <name>{{ port_shutdown_if_id }}</name>
        <shutdown/>
      </{{ port_shutdown_if_type }}>
    </interface>
  </native>
</config>
