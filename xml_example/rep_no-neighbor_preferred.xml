<?xml version="1.0"?>
<data xmlns="urn:ietf:params:xml:ns:netconf:base:1.0" xmlns:nc="urn:ietf:params:xml:ns:netconf:base:1.0">
  <native xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-native">
    <interface>
      <GigabitEthernet>
        <name>1/0/5</name>
        <switchport-config>
          <switchport>
            <mode xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-switch">
              <trunk/>
            </mode>
            <trunk xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-switch">
              <allowed>
                <vlan-v2>
                  <vlan-choices>
                    <vlans>100,200</vlans>
                  </vlan-choices>
                </vlan-v2>
              </allowed>
              <native>
                <vlan>
                  <vlan-id>100</vlan-id>
                </vlan>
              </native>
            </trunk>
          </switchport>
        </switchport-config>
        <rep xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-rep">
          <segment>
            <id>
              <id>5</id>
              <edge/>
              <no-neighbor_ch>
                <no-neighbor/>
                <primary/>
                <preferred/>
              </no-neighbor_ch>
            </id>
          </segment>
        </rep>
      </GigabitEthernet>
    </interface>
  </native>
</data>