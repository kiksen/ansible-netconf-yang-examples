<?xml version="1.0"?>
<data xmlns="urn:ietf:params:xml:ns:netconf:base:1.0" xmlns:nc="urn:ietf:params:xml:ns:netconf:base:1.0">
  <native xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-native">
    <interface>
      <GigabitEthernet>
        <name>1/0/4</name>
        <description>Verb.XXXX</description>
        <switchport-config>
          <switchport>
            <mode xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-switch">
              <trunk/>
            </mode>
            <trunk xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-switch">
              <allowed>
                <vlan-v2>
                  <vlan-choices>
                    <vlans>100,200,300</vlans>
                  </vlan-choices>
                </vlan-v2>
              </allowed>
              <native>
                <vlan>
                  <vlan-id>100</vlan-id>
                </vlan>
              </native>
            </trunk>
          </switchport>
        </switchport-config>
        <ip>
          <dhcp>
            <snooping xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-dhcp">
              <trust/>
            </snooping>
          </dhcp>
        </ip>
        <service-policy xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-policy">
          <output>raus</output>
        </service-policy>
        <vtp xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-vtp">false</vtp>
      </GigabitEthernet>
    </interface>
  </native>
</data>