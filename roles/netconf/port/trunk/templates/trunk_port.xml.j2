{% set port_trunk_if_type = port_trunk_interface | interface_part('type') %}
{% set port_trunk_if_id = port_trunk_interface | interface_part('id') %}
{% if port_trunk_rep %}
{% set port_trunk_rep_segment = port_trunk_interface | rep_segment %}
{% endif %}
<config xmlns="urn:ietf:params:xml:ns:netconf:base:1.0" xmlns:nc="urn:ietf:params:xml:ns:netconf:base:1.0">
  <native xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-native">
    <interface>
      <{{ port_trunk_if_type }} nc:operation="replace">
        <name>{{ port_trunk_if_id }}</name>
        <description>{{ port_trunk_description }}</description>
{% if not port_trunk_enabled %}
        <shutdown/>
{% endif %}
        <switchport-config>
          <switchport>
            <mode xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-switch">
              <trunk/>
            </mode>
{% if port_trunk_nonegotiate %}
            <nonegotiate xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-switch"/>
{% endif %}
            <trunk xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-switch">
{% if port_trunk_allowed_vlans != 'all' %}
              <allowed>
                <vlan-v2>
                  <vlan-choices>
                    <vlans>{{ port_trunk_allowed_vlans | vlan_list }}</vlans>
                  </vlan-choices>
                </vlan-v2>
              </allowed>
{% endif %}
{% if port_trunk_native_vlan is not none %}
              <native>
                <vlan>
                  <vlan-id>{{ port_trunk_native_vlan }}</vlan-id>
                </vlan>
              </native>
{% endif %}
            </trunk>
          </switchport>
        </switchport-config>
{% if port_trunk_rep %}
        <rep xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-rep">
          <segment>
            <id>
              <id>{{ port_trunk_rep_segment.id }}</id>
              <edge/>
              <no-neighbor_ch>
                <no-neighbor/>
{% if port_trunk_rep_segment.primary %}
                <primary/>
{% else %}
                <preferred/>
{% endif %}
              </no-neighbor_ch>
            </id>
          </segment>
        </rep>
{% endif %}
        <ip>
          <dhcp>
            <snooping xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-dhcp">
              <trust/>
            </snooping>
          </dhcp>
        </ip>
{% if port_trunk_no_cdp_enable %}
        <cdp xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-cdp">
          <enable>false</enable>
        </cdp>
{% endif %}
{% if port_trunk_no_lldp_receive or port_trunk_no_lldp_transmit %}
        <lldp xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-lldp">
{% if port_trunk_no_lldp_receive %}
          <receive>false</receive>
{% endif %}
{% if port_trunk_no_lldp_transmit %}
          <transmit>false</transmit>
{% endif %}
        </lldp>
{% endif %}
        <!-- <service-policy xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-policy">
          <output>{{ port_trunk_service_policy_out }}</output>
        </service-policy> -->
        <vtp xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-vtp">false</vtp>
      </{{ port_trunk_if_type }}>
    </interface>
  </native>
</config>
