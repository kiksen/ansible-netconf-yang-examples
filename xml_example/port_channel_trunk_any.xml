              <trust/>
            </snooping>
          </dhcp>
        </ip>
        <storm-control>
          <action>
            <trap/>
          </action>
          <multicast>
            <level>
              <threshold>
                <rising-threshold>3.0</rising-threshold>
              </threshold>
            </level>
          </multicast>
          <unicast>
            <level>
              <threshold>
                <rising-threshold>3.0</rising-threshold>
              </threshold>
            </level>
          </unicast>
        </storm-control>
      </Port-channel>
    </interface>
