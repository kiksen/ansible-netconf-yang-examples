{% set port_access_if_type = port_access_interface | kiksen.netconf.interface_part('type') %}
{% set port_access_if_id = port_access_interface | kiksen.netconf.interface_part('id') %}
<config xmlns="urn:ietf:params:xml:ns:netconf:base:1.0" xmlns:nc="urn:ietf:params:xml:ns:netconf:base:1.0">
  <native xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-native">
    <interface>
      <{{ port_access_if_type }} nc:operation="replace">
        <name>{{ port_access_if_id }}</name>
        <description>{{ port_access_description }}</description>
{% if not port_access_enabled %}
        <shutdown/>
{% endif %}
        <switchport-config>
          <switchport>
{# VLAN 1 is the default and not stored by the device, so it is not written. #}
{% if port_access_vlan | int != 1 %}
            <access xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-switch">
              <vlan>
                <vlan>{{ port_access_vlan }}</vlan>
              </vlan>
            </access>
{% endif %}
            <mode xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-switch">
              <access/>
            </mode>
            <nonegotiate xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-switch"/>
{% if port_access_voice_vlan is not none %}
            <voice xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-switch">
              <vlan>
                <vlan>{{ port_access_voice_vlan }}</vlan>
              </vlan>
            </voice>
{% endif %}
          </switchport>
        </switchport-config>
        <storm-control>
          <action>
            <trap/>
          </action>
          <broadcast>
            <level>
              <threshold>
                <rising-threshold>{{ port_access_storm_rising }}</rising-threshold>
                <falling-threshold>{{ port_access_storm_falling }}</falling-threshold>
              </threshold>
            </level>
          </broadcast>
          <multicast>
            <level>
              <threshold>
                <rising-threshold>{{ port_access_storm_rising }}</rising-threshold>
                <falling-threshold>{{ port_access_storm_falling }}</falling-threshold>
              </threshold>
            </level>
          </multicast>
        </storm-control>
{% if port_access_no_cdp_enable %}
        <cdp xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-cdp">
          <enable>false</enable>
        </cdp>
{% endif %}
{% if port_access_no_lldp_receive or port_access_no_lldp_transmit %}
        <lldp xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-lldp">
{% if port_access_no_lldp_receive %}
          <receive>false</receive>
{% endif %}
{% if port_access_no_lldp_transmit %}
          <transmit>false</transmit>
{% endif %}
        </lldp>
{% endif %}
        <service-policy xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-policy">
          <output>{{ port_access_service_policy_out }}</output>
        </service-policy>
        <spanning-tree xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-spanning-tree">
          <bpduguard>
            <enable/>
          </bpduguard>
          <portfast-v2>
            <access/>
          </portfast-v2>
          <portfast/>
        </spanning-tree>
      </{{ port_access_if_type }}>
    </interface>
  </native>
</config>
