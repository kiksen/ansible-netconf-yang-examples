{% set port_channel_member_if_type = port_channel_member_interface | interface_part('type') %}
{% set port_channel_member_if_id = port_channel_member_interface | interface_part('id') %}
<config xmlns="urn:ietf:params:xml:ns:netconf:base:1.0">
  <native xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-native">
    <interface>
      <{{ port_channel_member_if_type }}>
        <name>{{ port_channel_member_if_id }}</name>
        <channel-group xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-ethernet">
          <number>{{ port_channel_member_number }}</number>
          <mode>{{ port_channel_member_mode }}</mode>
        </channel-group>
      </{{ port_channel_member_if_type }}>
    </interface>
  </native>
</config>
