<?xml version="1.0"?>
<data xmlns="urn:ietf:params:xml:ns:netconf:base:1.0" xmlns:nc="urn:ietf:params:xml:ns:netconf:base:1.0">
  <native xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-native">
    <interface>
      <GigabitEthernet>
        <name>1/0/2</name>
        <description>AccessPoint</description>
        <switchport-config>
          <switchport>
            <mode xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-switch">
              <trunk/>
            </mode>
            <trunk xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-switch">
              <allowed>
                <vlan-v2>
                  <vlan-choices>
                    <vlans>2-4094</vlans>
                  </vlan-choices>
                </vlan-v2>
              </allowed>
            </trunk>
          </switchport>
        </switchport-config>
        <storm-control>
          <action>
            <trap/>
          </action>
          <multicast>
            <level>
              <threshold>
                <rising-threshold>3.0</rising-threshold>
              </threshold>
            </level>
          </multicast>
          <unicast>
            <level>
              <threshold>
                <rising-threshold>3.0</rising-threshold>
              </threshold>
            </level>
          </unicast>
        </storm-control>
        <spanning-tree xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-spanning-tree">
          <bpduguard>
            <enable/>
          </bpduguard>
          <portfast-v2>
            <trunk/>
          </portfast-v2>
          <portfast>
            <trunk/>
          </portfast>
        </spanning-tree>
      </GigabitEthernet>
    </interface>
  </native>
</data>